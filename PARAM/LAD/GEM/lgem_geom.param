; LAD GEM geometry
; Total two layers, each has one module

lgem_chanmap_file = "MAPS/LAD/DETEC/GEM/lgem_chan.map" ; 
;If using sim (is_mc=1), chanmap must be "MAPS/LAD/DETEC/GEM/lgem_chan_mc.map"

lgem_pedestal_mode = 0 ; temp test
lgem_pedfile = "PARAM/LAD/GEM/gem_ped_22528.dat" ;
lgem_cmfile = "PARAM/LAD/GEM/CommonModeRange_22528.txt" ; 

lgem_num_modules = 2;
lgem_num_layers = 2;

lgem_module_names = "m0, m1"; not used

lgem_m0_layer = 0
lgem_m1_layer = 1

; APV mapping configurations: 0 = INFN, 1 = UVA X/Y, 2 = UVA U/V
lgem_m0_apvmap = 1
lgem_m1_apvmap = 1

; Module positions/angles/rotations (lgem_mN_position, _angle, _rotation) are
; NOT set here.  They depend on the SHMS angle, so they live in per-setting
; files that standard.database picks by run number:
;   PARAM/LAD/GEM/lgem_align_shms17.param    (SHMS 17 deg,   runs < 23426)
;   PARAM/LAD/GEM/lgem_align_shms13p5.param  (SHMS 13.5 deg, runs >= 23426)
; See g_ctp_lad_gem_align_filename in DBASE/LAD/standard.database and
; DBASE/LAD_COIN/standard.database.  Do not add alignment constants here --
; this file is #include'd from general.param, which is loaded without a run
; number, so anything set here would override the run-selected values.

lgem_d0_cut = 20; cm


; strip angles
; X/Y are defined in lab coordinate system 
;TODO. Check definitions to make sure x & y are defined correctly
lgem_m0_uangle = 90.0
lgem_m0_vangle = 180.0

lgem_m1_uangle = 90.0
lgem_m1_vangle = 180.0

; Number of strips
lgem_m0_nstripsv = 3072
lgem_m0_nstripsu = 1536
lgem_m1_nstripsv = 3072
lgem_m1_nstripsu = 1536

; all modules have the same strip pitch along both dimensions, 0.4 mm:
lgem_upitch = 0.04
lgem_vpitch = 0.04
