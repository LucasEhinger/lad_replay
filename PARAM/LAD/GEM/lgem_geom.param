; LAD GEM geometry
; Total two layers, each has one module

lgem_chanmap_file = "MAPS/LAD/DETEC/GEM/lgem_chan.map" ; 
;If using sim (is_mc=1), chanmap must be "MAPS/LAD/DETEC/GEM/lgem_chan_mc.map"

lgem_pedfile = "PARAM/LAD/GEM/gem_ped_22528.dat" ;
lgem_cmfile = "PARAM/LAD/GEM/CommonModeRange_22528.txt" ; 

lgem_num_modules = 2;
lgem_num_layers = 2;

lgem_module_names = "m0, m1"; not used

lgem_m0_layer = 0
lgem_m1_layer = 1

; APV mapping configurations: 0 = INFN, 1 = UVA X/Y, 2 = UVA U/V
lgem_m0_apvmap = 1
lgem_m1_apvmap = 1

; Positions, all units in cm
; SHMS at 17 deg
lgem_m0_position =  0.0390553, 1.33479, 85.9126; 
lgem_m0_angle = 127.008, 0.057755; deg 
lgem_m0_rotation = -1.1876, 1.26238, -0.049502; deg


lgem_m1_position = -0.0337049, 1.33553, 105.913
lgem_m1_angle = 127, 0.000285756; deg 
lgem_m1_rotation = -0.322357 ,0.0888885,  -0.0762915; deg

; SHMS at 13.5 deg
;lgem_m0_position =  -0.0591264, 0.73661, 84.9545; 2nd alignment pass
;lgem_m0_angle = 126.585, 0.538076; deg 
;lgem_m0_rotation = 1.62673,0.984291, 0.247989; deg


